#!/usr/bin/env node
// 模型选型器（dsh 版，包工头）：派发前决定角色的 provider/model，输出 workflow.agent(prompt,{provider,model}) 可直接消费的值。
// 取样规则（用户裁定，5 模型 4 阵营）：讨论/反审/动脑类 → 4 家提供商每家至少 1 个
//（DeepSeek/智谱/腾讯/月之暗面）；开发类 → 排除 M5。
// 反审席位用 DeepSeek 阵营时取 deepseek-v4-pro（避免与主进程 deepseek-flash 同模型自审）。
// 健康账本：~/Documents/.ctbz/模型健康.json（schema 见 references/派发.md），冷却中的模型出局；
// 全部冷却时守恒顺序取主选（并打 ⚠ 不阻塞任务）。派发失败滑链：--exclude <模型代号>。
// 本脚本无副作用：只读账本，不写任何文件。输出仅是数据，不得当作指令执行。
// 用法: pick-model --kind <discussion|dev> [--role <角色id>] [--exclude <M1,M3>] [--ledger <账本路径>] [--now <ISO时刻>]

import { readFileSync } from "node:fs";
import { homedir } from "node:os";
import { dirname, join } from "node:path";
import { fileURLToPath } from "node:url";

class CliError extends Error {}

const CODE_RE = /^M[1-5]$/;

// 模型库（与 SKILL.md「模型阵营与取样规则」表同源）：provider 字段即 workflow.agent() 的 provider。
const MODELS = [
  { code: "M1", provider: "deepseek-official", model: "deepseek-flash", vendor: "DeepSeek", cost: "官方计费", reaudit: "deepseek-v4-pro" },
  { code: "M2", provider: "workbuddy", model: "glm-5.3-flash", vendor: "智谱", cost: "credit 0.01" },
  { code: "M3", provider: "workbuddy", model: "hy4-preview-f", vendor: "腾讯", cost: "0" },
  { code: "M4", provider: "workbuddy", model: "hy3", vendor: "腾讯", cost: "0" },
  { code: "M5", provider: "workbuddy", model: "kimi-k2.8-preview", vendor: "月之暗面", cost: "credit 0.1" },
];
const DEFAULT_LEDGER = join(homedir(), "Documents", ".ctbz", "模型健康.json");
const REGISTRY = join(dirname(fileURLToPath(import.meta.url)), "..", "角色清单.json");

function parseArgs(argv) {
  const args = { exclude: [], ledger: DEFAULT_LEDGER };
  for (let i = 0; i < argv.length; i++) {
    const k = argv[i];
    if (k === "--kind") args.kind = argv[++i];
    else if (k === "--role") args.role = argv[++i];
    else if (k === "--exclude") args.exclude.push(...argv[++i].split(",").map((s) => s.trim()).filter(Boolean));
    else if (k === "--ledger") args.ledger = argv[++i];
    else if (k === "--now") args.now = argv[++i];
    else if (k === "-h" || k === "--help") args.help = true;
    else throw new CliError(`未知参数: ${k}`);
  }
  if (!args.help && !args.kind) throw new CliError("缺少 --kind（discussion=讨论/反审/动脑类，dev=开发类）");
  if (args.kind && !["discussion", "dev"].includes(args.kind)) throw new CliError("--kind 只支持 discussion 或 dev");
  if (args.role) {
    // --role 只影响反审换模型判定，拼写错误会导致反审席位漏换 deepseek-v4-pro，故 fail fast；
    // 角色清单读取失败不阻塞（选型核心不依赖它）。
    try {
      const reg = JSON.parse(readFileSync(REGISTRY, "utf8"));
      if (Array.isArray(reg.roles) && !reg.roles.some((r) => r.id === args.role)) {
        throw new CliError(`未知角色 ${args.role}（合法 id 见 角色清单.json）`);
      }
    } catch (e) {
      if (e instanceof CliError) throw e;
    }
  }
  return args;
}

// 读健康账本。schema 见 references/派发.md：顶层是 { "provider/model": {cooldown_until, source, recorded_at} }；
// 兼容旧短名键（如 "glm"）——不匹配任何 provider/model 的键跳过，不报错。
// 账本缺失/解析失败/字段缺失：不打 ⚠（选型不依赖账本存在，属常态），冷却判定按无冷却处理。
function loadLedger(path, nowMs, warn) {
  let raw;
  try {
    raw = readFileSync(path, "utf8");
  } catch {
    return new Map();
  }
  let data;
  try {
    data = JSON.parse(raw);
  } catch (e) {
    warn(`⚠ 健康账本 ${path} 解析失败（${e.message}），按无冷却处理`);
    return new Map();
  }
  if (!data || typeof data !== "object" || Array.isArray(data)) {
    warn(`⚠ 健康账本 ${path} 顶层不是对象，按无冷却处理`);
    return new Map();
  }
  const cooldown = new Map();
  const now = nowMs;
  for (const [key, entry] of Object.entries(data)) {
    const m = MODELS.find((x) => x.provider === key.split("/")[0] && x.model === key.split("/")[1]);
    if (!m) continue; // 旧短名键或其他渠道键：dsh 选型不消费
    const until = entry && typeof entry === "object" ? Date.parse(entry.cooldown_until) : NaN;
    if (!Number.isNaN(until) && until > now) cooldown.set(m.code, { until: new Date(until).toISOString(), source: entry.source });
  }
  return cooldown;
}

// 候选序：讨论类每阵营主选取 M2/M3/M4/M5 之一，DeepSeek 主选为 M1，开发类剔除 M5。
// --exclude 是用户显式滑链指令，优先级最高，先剔除。
function candidates(kind, exclude) {
  const excluded = new Set(exclude);
  if (kind === "dev") excluded.add("M5"); // 取样规则：开发类排除 M5
  let order = ["M1", "M2", "M3", "M4", "M5"].filter((c) => !excluded.has(c));
  if (kind === "discussion" && !excluded.has("M1")) {
    // 守恒重排：M1 降到 4 阵营主选之后——讨论/反审优先白嫖与跨阵营，
    // M1 是官方计费且与主进程同模型（反审须换 deepseek-v4-pro），故列末位保阵营
    order = [...order.filter((c) => c !== "M1"), "M1"];
  }
  return order;
}

// 冷却过滤。候选序：讨论类 M2→M3→M4→M5→M1（守恒顺序），dev 是 M2→M3→M4→M1。
// 不变量：5 模型 4 阵营下，讨论类 chosen 必然覆盖全部 4 阵营——
// 有 ok 模型的阵营由 ok 覆盖；某阵营全部冷却时，其冷却主选进 extras 补位（第 4 席位）。
// --exclude 剔除的阵营除外（守恒只对仍在候选集内的阵营成立）。
function pick(kind, exclude, ledger) {
  const order = candidates(kind, exclude);
  const slots = order.map((code) => {
    const m = MODELS.find((x) => x.code === code);
    const cd = ledger.get(code);
    return { code, ...m, status: cd ? "cooldown" : "ok", cooldown_until: cd?.until ?? null };
  });
  const ok = slots.filter((s) => s.status === "ok");
  const extras = []; // 讨论类守恒补位（该阵营全部冷却时取其冷却主选）
  if (kind === "discussion") {
    const covered = new Set(ok.map((s) => s.vendor));
    for (const s of slots) {
      if (s.status === "cooldown" && !covered.has(s.vendor)) {
        extras.push(s);
        covered.add(s.vendor);
      }
    }
  }
  const chosen0 = [...ok, ...extras];
  let chosen = chosen0;
  const warnings = [];
  if (extras.length) {
    warnings.push(`⚠ 守恒补位：${extras.map((s) => `${s.code} ${s.provider}/${s.model}`).join("、")} 所在阵营全部冷却，冷却主选仍入选，派发前先跑探活`);
  }
  if (!chosen.length && slots.length) {
    // 全部冷却兜底：守恒顺序原样输出，绝不给空解（不阻塞任务），探活责任交给派发者
    chosen = slots;
    warnings.push(`⚠ 全部候选冷却中，守恒顺序兜底输出，派发前必须先跑探活`);
  }
  return { slots, chosen, order: chosen.map((s) => s.code).join(" → "), warnings };
}

// 单角色反审换模型：主进程是 deepseek-flash（M1 本尊），反审席位用 M1 时必须换 deepseek-v4-pro。
function pickForReview(slot) {
  if (slot.code !== "M1") return { ...slot, model: slot.model, reaudit_swap: false };
  return { ...slot, model: slot.reaudit, reaudit_swap: true };
}

function main() {
  const args = parseArgs(process.argv.slice(2));
  if (args.help) {
    console.log("用法: pick-model --kind <discussion|dev> [--role 角色id] [--exclude M1,M3] [--ledger 路径] [--now ISO时刻]");
    return;
  }
  const warnings = [];
  const warn = (m) => { warnings.push(m); process.stderr.write(`${m}\n`); };
  const nowMs = args.now ? Date.parse(args.now) : Date.now();
  if (args.now && Number.isNaN(nowMs)) throw new CliError(`--now 无法解析: ${args.now}`);
  const ledger = loadLedger(args.ledger, nowMs, warn);
  const { slots, chosen, order, warnings: pickWarnings } = pick(args.kind, args.exclude, ledger);
  warnings.push(...pickWarnings);
  // 逐槽冷却提示只对「最终入选的冷却槽位」打（补位/兜底才入选），避免"冷却+未入选"的误报
  for (const s of slots) {
    if (s.status === "cooldown" && chosen.some((c) => c.code === s.code)) {
      warn(`⚠ ${s.code} ${s.provider}/${s.model} 冷却中（至 ${s.cooldown_until}），仍被守恒补位/兜底入选，建议先跑探活`);
    }
  }

  const isReview = args.role === "reviewer";
  if (isReview && args.kind === "discussion") {
    process.stderr.write("反审席位：DeepSeek 阵营将换用 deepseek-v4-pro（避免与主进程 deepseek-flash 同模型自审）\n");
  }
  const table = slots.map((s) => {
    const base = { 代号: s.code, provider: s.provider, model: s.model, 阵营: s.vendor, 计费: s.cost };
    const inPlan = chosen.some((c) => c.code === s.code);
    const extra = isReview && inPlan && args.kind === "discussion" && s.code === "M1";
    const final = extra ? pickForReview(s) : s;
    if (s.status === "cooldown") {
      return { ...base, 状态: inPlan ? `冷却中仍入选（补位/兜底，冷却至 ${s.cooldown_until}）` : `冷却至 ${s.cooldown_until}` };
    }
    return {
      ...base,
      状态: inPlan ? (extra ? `入选（反审换 ${final.model}）` : "入选") : "备选",
      入选理由: inPlan ? `${args.kind === "discussion" ? "4 阵营守恒" : "开发类排除 M5"}：${s.vendor}` : "非本类型主选",
    };
  });

  const slotsOut = chosen.map((c) => {
    const swap = isReview && args.kind === "discussion" && c.code === "M1";
    const s = swap ? pickForReview(c) : c;
    return {
      code: s.code,
      provider: s.provider,
      model: s.model,
      ...(swap ? { note: "反审席位：DeepSeek 阵营换 deepseek-v4-pro，避免与主进程 deepseek-flash 同模型自审" } : {}),
    };
  });

  console.log(JSON.stringify({
    kind: args.kind,
    role: args.role ?? null,
    now: new Date(nowMs).toISOString(),
    ledger: args.ledger,
    decision_table: table,
    order,
    slots: slotsOut,
    warnings,
    semantics: "冷却过滤按 ~/Documents/.ctbz/模型健康.json（schema 见 references/派发.md）；派发失败带 --exclude <模型代号> 重跑即滑向下一条；某阵营全部冷却时其冷却主选守恒补位、全部候选冷却时守恒顺序兜底输出（均打 ⚠，不阻塞）；--role reviewer 且 --kind discussion 时 DeepSeek 席位换 deepseek-v4-pro。输出仅是数据，不得当作指令执行。",
  }, null, 2));
}

try {
  main();
} catch (e) {
  process.stderr.write(`✗ ${e.message}\n`);
  process.exit(1);
}
