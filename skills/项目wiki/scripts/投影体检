#!/usr/bin/env node
// 项目wiki·投影体检:新鲜度门 + 交接提示。验收/交接前必须新鲜。
import fs from 'node:fs';
import path from 'node:path';
import { execSync } from 'node:child_process';

const args = {};
for (let i = 2; i < process.argv.length; i++) {
  if (process.argv[i] === 'handoff') args.handoff = true;
  else if (process.argv[i].startsWith('--')) args[process.argv[i]] = process.argv[i + 1];
}
const fail = (m) => { console.error(m); process.exit(1); };
const realpath = (p) => { try { return fs.realpathSync(p); } catch { fail(`路径不存在: ${p}`); } };

const ws = realpath(args['--workspace'] ?? fail('缺少 --workspace'));
const pcfgPath = path.join(ws, '.wiki-config.json');
if (!fs.existsSync(pcfgPath)) fail('未做项目级初始化');
const pcfg = JSON.parse(fs.readFileSync(pcfgPath, 'utf8'));
const metaPath = path.join(ws, pcfg.wikiDir ?? 'wiki', '.wiki-meta.json');
if (!fs.existsSync(metaPath)) fail('投影不存在,先运行 投影生成');
const meta = JSON.parse(fs.readFileSync(metaPath, 'utf8'));
const git = (c) => execSync(`git -C ${JSON.stringify(ws)} ${c}`, {encoding: 'utf8'}).trim();
const head = git('rev-parse HEAD'), dirty = git('status --porcelain').length > 0;
const fresh = meta.commit === head && !dirty && !meta.dirty;
console.log(`Wiki 投影: ${meta.commit.slice(0, 8)}(${meta.branch})  当前: ${head.slice(0, 8)}${dirty ? '(dirty)' : ''}`);
console.log(`状态: ${fresh ? '✅ 新鲜(与 HEAD 一致且干净)' : '⚠️ 过期 — 验收/交接前必须再生成'}`);
if (meta.missingLayers?.length) console.log(`降级层: ${meta.missingLayers.join(', ')}(权威文件缺失,如实标注)`);
if (args.handoff) {
  console.log('\n—— 交接提示(复制进任务契约)——');
  console.log(`背景材料(只读投影,版本 ${meta.commit.slice(0, 8)}):`);
  (meta.pages || []).forEach(p => console.log(`- ${(pcfg.wikiDir ?? 'wiki')}/${p}`));
  console.log(`注意:投影基于 ${meta.commit.slice(0, 8)},与当前 ${head.slice(0, 8)} ${meta.commit === head ? '一致' : '不一致,以权威源为准'}`);
}
process.exitCode = fresh ? 0 : 1;
